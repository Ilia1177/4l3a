[Unit]
Description=C++ web server for 4l3a.duckdns.org
After=network.target

[Service]
Type=simple
# Adjust the user and paths below to match your Pi setup
User=pi
WorkingDirectory=/home/pi/pi-server/build
ExecStart=/home/pi/pi-server/build/server
Restart=on-failure
RestartSec=3

# Basic hardening — remove any of these if they cause issues
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
